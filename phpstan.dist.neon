includes:
    - vendor/mspirkov/yii2-phpstan/extension.neon

parameters:
    level: 5

    treatPhpDocTypesAsCertain: false

    paths:
        - behaviors
        - commands
        - components
        - config
        - controllers
        - mail
        - migrations
        - models
        - tests
        - views

    excludePaths:
        analyse:
            - tests/_support
            - tests/acceptance
        analyseAndScan:
            - config/__autocomplete.php
            - tests/_output

    bootstrapFiles:
        - vendor/yiisoft/yii2/Yii.php
        - config/env.php

    mspirkovYii2:
        enableAllRules: false
        enableValidationRules: true

        applicationConfigs:
            -
                paths:
                    - .
                files:
                    - config/web.php
            -
                paths:
                    - commands
                    - migrations
                files:
                    - config/console.php

        yiiAppTypes:
            -
                paths:
                    - .
                type: yii\console\Application|yii\web\Application<app\models\User>
                nullable: false
            -
                paths:
                    - controllers
                    - views
                type: yii\web\Application<app\models\User>
                nullable: false
            -
                paths:
                    - commands
                    - migrations
                type: yii\console\Application
                nullable: false

        aliases:
            '@app': .

    ignoreErrors:
        - '#Unsafe usage of new static\(\).#'

        # TODO: remove after fixing in crenspire/yii2-inertia.
        -
            message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(array\<mixed\>\|yii\\db\\ActiveRecord\)\: mixed\)\|null, Closure\(app\\models\\\w+\)\: array given\.$#'
            identifier: argument.type

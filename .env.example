# Application environment: dev, test or prod
YII_ENV=dev
YII_DEBUG=true

# Secret key used to sign cookies. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
COOKIE_VALIDATION_KEY=

# Database
DB_DSN="mysql:host=localhost;dbname=yii2basic"
DB_USERNAME=root
DB_PASSWORD=

# Test database (defaults to a SQLite file in runtime/ so tests run without MySQL)
# TEST_DB_DSN="mysql:host=localhost;dbname=yii2basic_test"

# Mail: when true, emails are written to runtime/mail instead of being sent
MAILER_USE_FILE_TRANSPORT=true
# MAILER_DSN="smtp://user:pass@smtp.example.com:587"
ADMIN_EMAIL=admin@example.com
SENDER_EMAIL=noreply@example.com
SENDER_NAME="Yii2 Starter"

# Vite dev server. Leave empty to serve the production build from web/dist.
VITE_DEV_SERVER=http://localhost:5173
